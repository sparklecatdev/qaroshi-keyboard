c Qaroshi AZERTY - positional Romanization keyboard
c Original layout source licensed under MIT. Built files are generated.
store(&VERSION) '17.0'
store(&NAME) 'Qaroshi AZERTY'
store(&COPYRIGHT) 'Copyright (c) 2026 Qaroshi contributors'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&LAYOUTFILE) 'qaroshi_azerty.keyman-touch-layout'

begin Unicode > use(main)

group(main) using keys
+ [K_Q] > 'a'
+ [SHIFT K_Q] > 'A'
+ [K_W] > 'z'
+ [SHIFT K_W] > 'Z'
+ [K_E] > 'e'
+ [SHIFT K_E] > 'E'
+ [K_R] > 'r'
+ [SHIFT K_R] > 'R'
+ [K_T] > 't'
+ [SHIFT K_T] > 'T'
+ [K_Y] > 'y'
+ [SHIFT K_Y] > 'Y'
+ [K_U] > 'u'
+ [SHIFT K_U] > 'U'
+ [K_I] > 'i'
+ [SHIFT K_I] > 'I'
+ [K_O] > 'o'
+ [SHIFT K_O] > 'O'
+ [K_P] > 'p'
+ [SHIFT K_P] > 'P'
+ [K_A] > 'q'
+ [SHIFT K_A] > 'Q'
+ [K_S] > 's'
+ [SHIFT K_S] > 'S'
+ [K_D] > 'd'
+ [SHIFT K_D] > 'D'
+ [K_F] > 'kh'
+ [SHIFT K_F] > 'Kh'
+ [K_G] > 'g'
+ [SHIFT K_G] > 'G'
+ [K_H] > 'h'
+ [SHIFT K_H] > 'H'
+ [K_J] > 'zh'
+ [SHIFT K_J] > 'Zh'
+ [K_K] > 'k'
+ [SHIFT K_K] > 'K'
+ [K_L] > 'l'
+ [SHIFT K_L] > 'L'
+ [K_COLON] > 'm'
+ [SHIFT K_COLON] > 'M'
+ [K_Z] > 'w'
+ [SHIFT K_Z] > 'W'
+ [K_X] > 'ng'
+ [SHIFT K_X] > 'Ng'
+ [K_C] > 'ë'
+ [SHIFT K_C] > 'Ë'
+ [K_V] > 'sh'
+ [SHIFT K_V] > 'Sh'
+ [K_B] > 'b'
+ [SHIFT K_B] > 'B'
+ [K_N] > 'n'
+ [SHIFT K_N] > 'N'
+ [K_M] > ','
+ [SHIFT K_M] > ','
+ [K_COMMA] > ';'
+ [SHIFT K_COMMA] > ';'
+ [K_PERIOD] > ':'
+ [SHIFT K_PERIOD] > ':'
+ [K_SLASH] > '!'
+ [SHIFT K_SLASH] > '!'
+ [K_0] > 'à'
+ [SHIFT K_0] > '0'
+ [K_1] > '&'
+ [SHIFT K_1] > '1'
+ [K_2] > 'é'
+ [SHIFT K_2] > '2'
+ [K_3] > '"'
+ [SHIFT K_3] > '3'
+ [K_4] > U+0027
+ [SHIFT K_4] > '4'
+ [K_5] > '('
+ [SHIFT K_5] > '5'
+ [K_6] > '-'
+ [SHIFT K_6] > '6'
+ [K_7] > 'è'
+ [SHIFT K_7] > '7'
+ [K_8] > '_'
+ [SHIFT K_8] > '8'
+ [K_9] > 'ç'
+ [SHIFT K_9] > '9'
+ [K_LBRKT] > '^'
+ [SHIFT K_LBRKT] > '¨'
+ [K_RBRKT] > '$'
+ [SHIFT K_RBRKT] > '£'
+ [K_QUOTE] > 'ù'
+ [SHIFT K_QUOTE] > '%'
+ [K_HYPHEN] > ')'
+ [SHIFT K_HYPHEN] > '°'
+ [K_EQUAL] > '='
+ [SHIFT K_EQUAL] > '+'
+ [K_BKSLASH] > '*'
+ [SHIFT K_BKSLASH] > 'µ'
