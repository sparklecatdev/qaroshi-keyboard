c Qaroshi QWERTY - positional Romanization keyboard
c Original layout source licensed under MIT. Built files are generated.
store(&VERSION) '17.0'
store(&NAME) 'Qaroshi QWERTY'
store(&COPYRIGHT) 'Copyright (c) 2026 Qaroshi contributors'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'
store(&LAYOUTFILE) 'qaroshi_qwerty.keyman-touch-layout'

begin Unicode > use(main)

group(main) using keys
+ [K_Q] > 'q'
+ [SHIFT K_Q] > 'Q'
+ [K_W] > 'w'
+ [SHIFT K_W] > 'W'
+ [K_E] > 'e'
+ [SHIFT K_E] > 'E'
+ [K_R] > 'r'
+ [SHIFT K_R] > 'R'
+ [K_T] > 't'
+ [SHIFT K_T] > 'T'
+ [K_Y] > 'y'
+ [SHIFT K_Y] > 'Y'
+ [K_U] > 'u'
+ [SHIFT K_U] > 'U'
+ [K_I] > 'i'
+ [SHIFT K_I] > 'I'
+ [K_O] > 'o'
+ [SHIFT K_O] > 'O'
+ [K_P] > 'p'
+ [SHIFT K_P] > 'P'
+ [K_A] > 'a'
+ [SHIFT K_A] > 'A'
+ [K_S] > 's'
+ [SHIFT K_S] > 'S'
+ [K_D] > 'd'
+ [SHIFT K_D] > 'D'
+ [K_F] > 'kh'
+ [SHIFT K_F] > 'Kh'
+ [K_G] > 'g'
+ [SHIFT K_G] > 'G'
+ [K_H] > 'h'
+ [SHIFT K_H] > 'H'
+ [K_J] > 'zh'
+ [SHIFT K_J] > 'Zh'
+ [K_K] > 'k'
+ [SHIFT K_K] > 'K'
+ [K_L] > 'l'
+ [SHIFT K_L] > 'L'
+ [K_COLON] > ';'
+ [SHIFT K_COLON] > ';'
+ [K_Z] > 'z'
+ [SHIFT K_Z] > 'Z'
+ [K_X] > 'ng'
+ [SHIFT K_X] > 'Ng'
+ [K_C] > 'ë'
+ [SHIFT K_C] > 'Ë'
+ [K_V] > 'sh'
+ [SHIFT K_V] > 'Sh'
+ [K_B] > 'b'
+ [SHIFT K_B] > 'B'
+ [K_N] > 'n'
+ [SHIFT K_N] > 'N'
+ [K_M] > 'm'
+ [SHIFT K_M] > 'M'
+ [K_COMMA] > ','
+ [SHIFT K_COMMA] > ','
+ [K_PERIOD] > '.'
+ [SHIFT K_PERIOD] > '.'
+ [K_SLASH] > '/'
+ [SHIFT K_SLASH] > '/'
+ [K_LBRKT] > '['
+ [SHIFT K_LBRKT] > '{'
+ [K_RBRKT] > ']'
+ [SHIFT K_RBRKT] > '}'
+ [K_QUOTE] > U+0027
+ [SHIFT K_QUOTE] > '"'
+ [K_HYPHEN] > '-'
+ [SHIFT K_HYPHEN] > '_'
+ [K_EQUAL] > '='
+ [SHIFT K_EQUAL] > '+'
